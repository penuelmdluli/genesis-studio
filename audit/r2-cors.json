{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://genesisstudio.app",
          "https://www.genesisstudio.app",
          "http://localhost:3000"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["*"]
      },
      "exposed_headers": ["Content-Length", "Content-Type", "ETag"],
      "max_age_seconds": 86400
    }
  ]
}
